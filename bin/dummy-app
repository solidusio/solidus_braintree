#!/usr/bin/env bash

set -e

extension_name="solidus_braintree"

# Stay away from the bundler env of the containing extension.
function unbundled {
  ruby -rbundler -e'b = proc {system(*ARGV) or exit 1}; Bundler.respond_to?(:with_unbundled_env) ? Bundler.with_unbundled_env(&b) : Bundler.with_clean_env(&b)' -- "$@"
}

# "sqlite" is set by the ORB extension instead of "sqlite3",
# all other options are already in the format expected by `rails new`.
test "$DB" = "sqlite" && export DB="sqlite3"

rm -rf ./dummy-app
rails_version=`bundle exec ruby -e'require "rails"; puts Rails.version'`
bundle exec rails _${rails_version}_ new dummy-app \
  --database=${DB:-sqlite3} \
  --skip-git \
  --skip-keeps \
  --skip-rc \
  --skip-bootsnap \
  --skip-test

if [ ! -d "dummy-app" ]; then
  echo 'dummy-app rails application failed'
  exit 1
fi

cd ./dummy-app

mkdir -p app/assets/config
cat <<MANIFESTJS > app/assets/config/manifest.js
//= link_tree ../images
//= link_directory ../javascripts .js
//= link_directory ../stylesheets .css
MANIFESTJS

unbundled bundle add solidus --github solidusio/solidus --branch "${SOLIDUS_BRANCH:-${BRANCH:-main}}" --version '> 0.a'
# ActiveSupport < 8.1 passes `quirks_mode` to JSON.generate, which json 3 rejects.
if ruby -e "exit Gem::Version.new('$rails_version') < Gem::Version.new('8.1')"; then
  unbundled bundle add json --version '< 3'
fi
unbundled bundle exec rake db:drop db:create
# Solidus >= 4.8 fetches the storefront from main for prerelease (.dev) versions,
# which on a stable branch installs a storefront incompatible with its core.
if [ -n "$SOLIDUS_BRANCH" ] && [ -z "$SOLIDUS_STOREFRONT_TEMPLATE" ]; then
  export SOLIDUS_STOREFRONT_TEMPLATE="https://github.com/solidusio/solidus/raw/$SOLIDUS_BRANCH/storefront/template.rb"
fi
unbundled bundle exec rails generate solidus:install --auto-accept --payment-method=none --no-seed --no-sample --admin-preview=false "$@"
unbundled bundle add $extension_name --path ..
unbundled bundle exec rails generate $extension_name:install --migrate --specs=all
